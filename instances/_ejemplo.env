# Copiar a instances/<instancia>.env y rellenar.
# chmod 600 instances/*.env   ·   NUNCA a git (hay .gitignore).
#
# La topología del nodo (ws/wss, puerto, host público) NO va aquí:
# vive en nodes/<nodo>.env y deploy.sh la recibe con --node.

USER_NAME=juan                 # etiqueta humana; NO identifica el sandbox

# Id único de la fila `containers` (lo asigna el Sandbox Manager).
# Es el sufijo del container_name: alice-${ALICE_SANDBOX_ID}.
# No lo reutilices entre sandboxes: dos re-provisions del mismo usuario
# necesitan ids distintos o Docker choca.
ALICE_SANDBOX_ID=

# Tag FIJO, no `latest`. Rollback = cambiar esta línea y redeploy.
LETTA_TAG=0.34.39

# Hash SHA-256 (64 hex) del capability token. NO es el token: es su digest.
# Lo calcula el backend/manager; el token en claro vive cifrado en PostgreSQL.
# El contenedor recibe solo el hash (--ws-token-sha256), nunca el token.
# Cálculo (lado backend, una vez): printf '%s' "$TOKEN" | sha256sum
WS_TOKEN_SHA256=

# LiteLLM: una virtual key por instancia, con budget y límite de modelos.
LITELLM_BASE_URL=http://litellm:4000   # OpenAI-compatible: el SDK añade /v1
LITELLM_API_KEY=sk-virtual-CAMBIAME

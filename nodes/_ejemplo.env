# Topología de UN nodo (host Docker). Copiar a nodes/<nodo>.env y rellenar.
# chmod 600 nodes/*.env   ·   NUNCA a git (hay .gitignore).
#
# No va en instances/<usuario>.env: todos los sandboxes del nodo comparten
# estas variables. El manager pasa `--node <nodo>`; un humano puede exportar
# NODE_ID=<nodo> o dejar un único nodes/*.env (deploy.sh avisa por stderr).

# ws  = mismo host, red Docker `sandboxes`, DNS interno (alice-<ALICE_SANDBOX_ID>:4500).
# wss = detrás de Cloudflare Tunnel / VPS remoto (host-público:443).
# Obligatoria: sin ella, INVALID_INPUT.
SANDBOX_TRANSPORT=ws

# Puerto que usan el gateway/backend para conectar: 4500 con ws, 443 con wss.
# NO es el puerto interno del contenedor: el App Server siempre escucha en 4500.
# Si se omite: 4500 con ws, 443 con wss.
SANDBOX_PORT=4500

# Hostname que resuelve al sandbox.
# - Vacío con ws: se usa el nombre del contenedor (alice-<ALICE_SANDBOX_ID>).
# - Con wss es obligatorio: un túnel sin hostname no es alcanzable.
SANDBOX_PUBLIC_HOST=

# Nombre de la red Docker externa que comparten gateway y sandboxes.
# El compose la declara como `external: true`; si se omite, default `sandboxes`.
SANDBOX_NETWORK=sandboxes
